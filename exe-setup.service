[Unit]
Description=Run /exe.dev/setup script on first boot
ConditionPathExists=/exe.dev/setup
After=network.target

[Service]
Type=oneshot
User=lk
Group=lk
WorkingDirectory=/home/lk
ExecStart=/bin/bash -c /exe.dev/setup
ExecStartPost=/usr/bin/sudo /bin/rm -f /exe.dev/setup
Environment=HOME=/home/lk
Environment=USER=lk
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exe-setup
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
